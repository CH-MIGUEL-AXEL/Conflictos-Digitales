{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "convivencia": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": { "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"], "assets": [{ "glob": "**/*", "input": "public" }], "outputPath": "dist/convivencia" },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }] },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          }, "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "convivencia:build:production" }, "development": { "buildTarget": "convivencia:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  }
}
